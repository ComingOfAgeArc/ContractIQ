# Copy this file to .env and fill in the values. Never commit .env.

PORT=5000

# MongoDB Atlas connection string (Atlas UI → Connect → Drivers).
# The database name goes after the host: ...mongodb.net/contractiq?...
MONGODB_URI=

# Browser origins allowed to call the API (CORS). Comma-separated.
# Not needed when Express serves the built client itself (the Render setup in render.yaml).
CLIENT_URL=http://localhost:5173

# Needed from Phase 2 onwards (Google AI Studio → Get API key)
GEMINI_API_KEY=

# Embeddings (Phase 2). Changing either means: recreate the vector index + re-process contracts.
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# Text generation (Phase 3): answers + clause extraction. Safe to change any time.
# gemini-3.5-flash-lite = fastest/cheapest; gemini-3.8-flash = smarter
CHAT_MODEL=gemini-3.5-flash-lite

# Reranking for /api/ask: Gemini re-scores the retrieved clauses before answering.
# off (default) = unchanged behaviour. on = one extra Gemini call per question (slower, often more accurate).
# The Ask page can also switch it per question. Measure the effect with: npm run eval -- --rerank
RERANK=off

# Background processing after upload: chunk → embed → index → analyse.
# AUTO_ANALYZE=on (default) also runs the clause analysis (one Gemini call per contract).
# off = stop after indexing; you can still click "Analyse contract" later.
AUTO_ANALYZE=on
# How many contracts are processed at the same time (1-4). Lower it if you hit Gemini rate limits.
PROCESSING_CONCURRENCY=2
